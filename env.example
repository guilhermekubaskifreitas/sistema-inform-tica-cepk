NODE_ENV=development
PORT=3000

# PostgreSQL local via docker-compose ou URL do provedor externo (Render/Railway/Neon).
# Exemplo local: postgresql://cepk:cepk@localhost:5432/cepk
# Em produção, use a connection string direta do Neon (sem -pooler) com sslmode=require.
DATABASE_URL="postgresql://cepk:cepk@localhost:5432/cepk"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-only-change-me-access-secret-0123456789abcdef"
JWT_REFRESH_SECRET="dev-only-change-me-refresh-secret-0123456789abcdef"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# URL do front-end (para links e CORS).
APP_URL="http://localhost:5500"
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"

# URL pública desta API (usada nos botões do e-mail).
# No Render, se ficar vazia, usa automaticamente RENDER_EXTERNAL_URL.
API_PUBLIC_URL="http://localhost:3000"

# Domínios permitidos no autocadastro, separados por vírgula.
# Deixe vazio para permitir qualquer e-mail (apenas em desenvolvimento).
ALLOWED_EMAIL_DOMAINS="escola.pr.gov.br"

# Destino(s) das aprovações de cadastro, separados por vírgula.
# Se ficar vazio, usa ADMIN_EMAIL.
APPROVAL_EMAIL=""

# Destino(s) das aprovações de reserva, separados por vírgula.
# Se ficar vazio, usa APPROVAL_EMAIL e depois ADMIN_EMAIL.
RESERVATION_EMAIL=""

# Resend (API HTTPS, recomendado no Render free). Tem prioridade sobre SMTP.
# Em teste, onboarding@resend.dev só entrega para o e-mail dono da conta.
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# SMTP alternativo (local). Se ambos ficarem vazios, a API imprime os links no console.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Agenda CEPK <no-reply@cepk.local>"

# Usuário inicial criado pelo seed (opcional, mas recomendado).
ADMIN_NAME="Secretaria CEPK"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
